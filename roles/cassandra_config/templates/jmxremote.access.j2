{% for user in cassandra_jmx_users %}
{% set access = user.access | default('readwrite') %}
{% if access == 'readwrite' and user.create_unregister | default(true) | bool %}
{{ user.name }} readwrite \
    create javax.management.monitor.*,javax.management.timer.* \
    unregister
{% else %}
{{ user.name }} {{ access }}
{% endif %}
{% endfor %}

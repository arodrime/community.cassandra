{#- What tasks/new_node_checks.yml checks on this host, from the inventory and
    the roles' defaults, as JSON: the directories, the packages (installed, or
    available), the URLs, the ports to reach and its own ports, plus the
    problems and facts found on the way. Same choices as the roles: Java and
    Cassandra (cassandra_install), cqlsh's Python (cassandra_install),
    Medusa's Python and pip index (cassandra_medusa). -#}
{%- set offline = cassandra_offline | bool -%}
{%- set debian = ansible_facts['os_family'] == 'Debian' -%}
{%- set py3 = (cassandra_new_node_python3.stdout | default('') | trim) if cassandra_new_node_python3.rc | default(1) == 0 else '' -%}
{%- set have = dict(cassandra_new_node_paths.results | map(attribute='item') | zip(cassandra_new_node_paths.results | map(attribute='stat.exists'))) -%}
{%- set problems = [] -%}{%- set info = [] -%}{%- set packages = [] -%}{%- set urls = [] -%}{%- set reach = [] -%}{%- set dirs = [] -%}

{#- Access -#}
{%- set uid = cassandra_new_node_uid.stdout | default('') | trim -%}
{%- if uid != '0' -%}
{%-   set _ = problems.append('Ansible runs as user ID ' ~ uid ~ ', not root: the roles install packages (the playbooks ask for root: an inventory ansible_become: false or another ansible_become_user?)') -%}
{%- endif -%}
{%- set _ = info.append('Ansible: ' ~ (ansible_facts['python']['executable'] | default('python')) ~ ' ' ~ (ansible_facts['python_version'] | default('?')) ~ (', as root' if uid == '0' else '')) -%}

{#- Directories -#}
{#- the path with its links resolved decides the file system -#}
{%- set real = dict(_dirs | zip(cassandra_new_node_realpath.stdout_lines | default([])))
               if cassandra_new_node_realpath.stdout_lines | default([]) | length == _dirs | length else {} -%}
{%- set kinds = ([['data']] * ([cassandra_data_file_directories] | flatten | length)) | flatten + ['commitlog', 'hints', 'saved_caches'] -%}
{%- for k, d in kinds | zip([cassandra_data_file_directories] | flatten + [cassandra_commitlog_dir, cassandra_hints_dir, cassandra_saved_caches_dir]) -%}
{%-   set _ = dirs.append({'kind': k, 'path': d, 'real': real.get(d) or d}) -%}
{%- endfor -%}

{#- Java -#}
{%- if cassandra_install_java | bool and _cassandra_java_home == '' -%}
{%-   set _ = packages.append({'name': cassandra_java_package, 'why': 'Java', 'mode': 'installed' if offline else 'either'}) -%}
{%- endif -%}
{%- set java_there = have.get(_cassandra_java_home ~ '/.unpacked', false)
                     or (cassandra_java_home != '' and have.get(_cassandra_java_home ~ '/bin/java', false)) -%}
{%- if cassandra_java_tarball is match('https?://') and not java_there -%}
{%-   if offline -%}
{%-     set _ = problems.append('cassandra_offline downloads nothing, and the Java tarball is not unpacked in ' ~ _cassandra_java_home ~ ': give cassandra_java_tarball as a file on the controller, or unpack it there first') -%}
{%-   else -%}
{%-     set _ = urls.append({'name': 'Java tarball', 'url': cassandra_java_tarball, 'headers': {'Range': 'bytes=0-0'}, 'auth': 'java'}) -%}
{%-   endif -%}
{%- endif -%}

{#- Cassandra: from the repository the role adds, from package files (cassandra_install_method packages),
    from repositories set up by other means, or installed already (offline) -#}
{%- set files_method = cassandra_install_method == 'packages' -%}
{%- set base = cassandra_install_url | regex_replace('/+$', '') -%}
{%- if files_method and not offline and cassandra_package_version == '' -%}
{%-   set _ = problems.append('cassandra_install_method packages needs cassandra_package_version: it names the files to download') -%}
{%- elif files_method and not offline -%}
{#-   with cassandra-tools unless cassandra_install_tools is false -#}
{%-   for p in _cassandra_packages -%}
{%-     set f = cassandra_install_package_file | replace('{name}', p) | replace('{version}', cassandra_package_version) -%}
{%-     set _ = urls.append({'name': 'Cassandra package file ' ~ f, 'auth': 'repository', 'headers': {'Range': 'bytes=0-0'}, 'url': base ~ '/' ~ f}) -%}
{%-   endfor -%}
{%- elif cassandra_repository_manage | bool and not files_method -%}
{%-   if debian -%}
{%-     set _ = urls.append({'name': 'Cassandra repository', 'auth': 'repository',
                             'url': base ~ '/dists/' ~ cassandra_version ~ '/InRelease'}) -%}
{%-   else -%}
{%-     set _ = urls.append({'name': 'Cassandra repository', 'auth': 'repository',
                             'url': base ~ '/repodata/repomd.xml'}) -%}
{%-   endif -%}
{%-   if cassandra_repository_key_url != '' -%}
{%-     set _ = urls.append({'name': 'Cassandra signing keys', 'auth': 'repository', 'url': cassandra_repository_key_url}) -%}
{%-   endif -%}
{%- endif -%}
{%- if offline or not (cassandra_repository_manage | bool or files_method) -%}
{%-   set _ = packages.append({'name': 'cassandra', 'why': 'Cassandra', 'mode': 'installed' if offline else 'either',
                               'version': cassandra_package_version}) -%}
{%- endif -%}
{%- if offline and cassandra_java_tarball != '' and not java_there -%}
{%-   set _ = packages.append({'name': 'tar', 'why': 'Java tarball', 'mode': 'installed'}) -%}
{%- endif -%}

{#- cqlsh's Python: python3 when the series' cqlsh supports it, else python3.11 -#}
{%- set range = cassandra_cqlsh_python_supported[cassandra_version] | default([]) -%}
{%- set py311_need = {'name': 'python3.11', 'mode': 'warn' if offline else 'either',
                      'fallback': 'the deadsnakes PPA' if ansible_facts['distribution'] == 'Ubuntu' and cassandra_cqlsh_python_repo_uri != '' else ''} -%}
{#- set when cassandra_install adds the PPA (it installs python3.11 for cqlsh) -#}
{%- set ppa = namespace(added=false) -%}
{%- if cassandra_cqlsh_python == '/usr/bin/python3.11' and not have.get('/usr/bin/python3.11', false) -%}
{%-   set _ = packages.append(dict(py311_need, why='cqlsh, cassandra_cqlsh_python')) -%}
{%-   set ppa.added = cassandra_cqlsh_python_manage | bool -%}
{%- elif cassandra_cqlsh_python != '' -%}
{%-   if not have.get(cassandra_cqlsh_python, false) -%}
{%-     set _ = problems.append('cassandra_cqlsh_python ' ~ cassandra_cqlsh_python ~ ' does not exist: cqlsh would not run') -%}
{%-   endif -%}
{%- elif not py3 -%}
{%-   set _ = info.append('python3: not installed yet, the Cassandra package brings it (cqlsh runs on it when it fits)') -%}
{%- elif range and not (py3 is version(range[0], '>=') and py3 is version(range[1], '<=')) -%}
{%-   if have.get('/usr/bin/python3.11', false) -%}
{%-     set _ = info.append('cqlsh: python3 ' ~ py3 ~ ' does not fit, runs on /usr/bin/python3.11') -%}
{%-   else -%}
{%-     set _ = packages.append(dict(py311_need, why='cqlsh, python3 ' ~ py3 ~ ' is outside ' ~ range | join('-'))) -%}
{%-     set ppa.added = cassandra_cqlsh_python_manage | bool -%}
{%-   endif -%}
{%- else -%}
{%-   set _ = info.append('cqlsh: python3 ' ~ py3) -%}
{%- endif -%}

{#- Medusa's Python: a new virtualenv (an existing one keeps its own), or pip into the system Python -#}
{%- if cassandra_medusa_enabled | default(false) | bool -%}
{%-   set mrange = cassandra_medusa_python_supported -%}
{%-   if cassandra_medusa_venv != '' and have.get(cassandra_medusa_venv ~ '/bin/python', false) -%}
{%-     set _ = info.append('Medusa: virtualenv ' ~ cassandra_medusa_venv ~ ' already there') -%}
{%-   else -%}
{%-     set mode = 'installed' if offline else 'either' -%}
{%-     if cassandra_medusa_python == '/usr/bin/python3.11' and not debian -%}
{%-       for p in ['python3.11', 'python3.11-pip'] -%}
{%-         set _ = packages.append({'name': p, 'why': 'Medusa, cassandra_medusa_python', 'mode': mode}) -%}
{%-       endfor -%}
{%-     elif cassandra_medusa_python != '' -%}
{%-       if not have.get(cassandra_medusa_python, false) -%}
{%-         set _ = problems.append('cassandra_medusa_python ' ~ cassandra_medusa_python ~ ' does not exist') -%}
{%-       endif -%}
{%-     elif not py3 -%}
{%-       set _ = info.append('Medusa: python3 not installed yet, its Python is chosen at install') -%}
{%-     elif py3 is version(mrange[0], '>=') and py3 is version(mrange[1], '<=') -%}
{%-       if cassandra_medusa_venv == '' -%}
{#-         none needed when the system Python has Medusa already -#}
{%-         set _ = packages.append({'name': 'python3-pip', 'why': 'Medusa', 'mode': 'warn' if offline else mode}) -%}
{%-       elif debian -%}
{%-         set _ = packages.append({'name': 'python3-venv', 'why': 'Medusa virtualenv', 'mode': mode}) -%}
{%-       endif -%}
{%-     elif not debian -%}
{%-       for p in ['python3.11', 'python3.11-pip'] -%}
{%-         set _ = packages.append({'name': p, 'why': 'Medusa, python3 ' ~ py3 ~ ' is outside ' ~ mrange | join('-'), 'mode': mode}) -%}
{%-       endfor -%}
{%-     elif cassandra_medusa_venv != '' and debian -%}
{#-       a virtualenv on python3.11 (Ubuntu 26.04: from the deadsnakes PPA cassandra_install adds for cqlsh) -#}
{%-       set _ = packages.append({'name': 'python3.11-venv', 'mode': mode, 'fallback': py311_need.fallback if ppa.added else '',
                                   'why': 'Medusa virtualenv, python3 ' ~ py3 ~ ' is outside ' ~ mrange | join('-')}) -%}
{%-     else -%}
{%-       set _ = problems.append('Medusa ' ~ cassandra_medusa_version ~ ' runs on Python ' ~ mrange | join(' to ') ~ ', python3 here is ' ~ py3 ~ ': set cassandra_medusa_python to such an interpreter (installed by other means)') -%}
{%-     endif -%}
{%-     if offline and cassandra_medusa_pip_index_url == '' and cassandra_medusa_venv != '' -%}
{%-       set _ = problems.append('cassandra_offline downloads nothing, and Medusa is not in ' ~ cassandra_medusa_venv ~ ': install it from your image, or set cassandra_medusa_pip_index_url to a PyPI mirror the host reaches') -%}
{%-     elif cassandra_medusa_pip_index_url == '' and cassandra_medusa_pip_extra_args | select('match', '--(index-url|extra-index-url|find-links|no-index)|-[if]') | list -%}
{%-       set _ = info.append('Medusa pip index: set by cassandra_medusa_pip_extra_args, not checked') -%}
{%-     elif not (offline and cassandra_medusa_pip_index_url == '') -%}
{%-       set _ = urls.append({'name': 'Medusa pip index', 'auth': 'pip', 'ca_path': cassandra_medusa_pip_cert,
                               'url': (cassandra_medusa_pip_index_url or 'https://pypi.org/simple') | regex_replace('/+$', '') ~ '/cassandra-medusa/',
                               'match': '(?i)cassandra[-_]medusa-' ~ (cassandra_medusa_version | string | regex_escape) ~ '[.-]',
                               'what': 'cassandra-medusa ' ~ cassandra_medusa_version,
                               'soft': cassandra_medusa_pip_index_url == ''}) -%}
{%-     endif -%}
{%-   endif -%}
{%- endif -%}

{#- Network: the seeds' ports from here, and this host's own ports -#}
{%- set legacy_ssl = cassandra_legacy_ssl_storage_port_enabled | bool and cassandra_internode_encryption != 'none' -%}
{#- the seeds as listed, with their port when one is given -#}
{%- set seeds = ((cassandra_seeds.split(',') if cassandra_seeds is string else cassandra_seeds) | map('trim') | select | list)[:2] -%}
{%- for entry in seeds -%}
{#-   host:port, [IPv6]:port, or an address alone (a bare IPv6 address has several colons) -#}
{%-   set m = entry | regex_search('^\\[(.+)\\]:([0-9]+)$|^([^:]+):([0-9]+)$', '\\1', '\\2', '\\3', '\\4') or [] -%}
{%-   set seed = (m[0] or m[2]) if m else entry | regex_replace('^\\[(.*)\\]$', '\\1') -%}
{%-   set _ = reach.append({'name': 'storage', 'host': seed, 'port': ((m[1] or m[3]) if m else cassandra_storage_port) | int}) -%}
{%-   if legacy_ssl -%}
{%-     set _ = reach.append({'name': 'SSL storage', 'host': seed, 'port': cassandra_ssl_storage_port | int}) -%}
{%-   endif -%}
{%-   if cassandra_start_native_transport | bool -%}
{#-     clients' port: firewalls may keep it to the application hosts -#}
{%-     set _ = reach.append({'name': 'native (CQL)', 'host': seed, 'port': cassandra_native_transport_port | int, 'optional': true}) -%}
{%-   endif -%}
{%- endfor -%}
{%- set own_ports = [{'name': 'storage', 'port': cassandra_storage_port | int}, {'name': 'native (CQL)', 'port': cassandra_native_transport_port | int},
                     {'name': 'JMX', 'port': cassandra_jmx_port | int}] + ([{'name': 'SSL storage', 'port': cassandra_ssl_storage_port | int}] if legacy_ssl else []) -%}

{{ {'problems': problems, 'info': info, 'dirs': dirs, 'packages': packages, 'urls': urls, 'reach': reach, 'own_ports': own_ports} | to_json }}

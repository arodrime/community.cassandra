    The OS tuning import_cluster reads on each node (task "Read the OS tuning"): sysctl, limits, THP, tuned,
    the disks of the data and commitlog dirs, swap, time sync, firewall; kind|...| lines for the cassandra_os
    filters. A Jinja template (lookup('ansible.builtin.template')), run by the shell module: {{ }} are the
    task's variables. -#}
set -- {{ _dirs | map('quote') | join(' ') }}  # the data and commitlog dirs
ports='{{ _ports | join('|') }}'
seen=
once() { r=$(readlink -f "$1"); case " $seen " in *" $r "*) return 1 ;; esac; seen="$seen $r"; }
# the package a file under /etc comes from (a distro default, not set by the admin)
owner() {
  case $1 in /etc/*) ;; *) return ;; esac
  o=$(rpm -qf --qf '%{NAME}\n' "$1" 2>/dev/null) && o=$(echo "$o" | head -1) || o=$(dpkg -S "$1" 2>/dev/null | cut -d: -f1) || o=
  [ -n "$o" ] && echo "owner|$1|$o"
}
# the lines of a file, comments and blank lines left out: kind|file|line
f() {
  k=$1; shift
  for x in "$@"; do
    # a link to /dev/null masks the file of that name in the other dirs
    [ -L "$x" ] && [ "$(readlink -f "$x")" = /dev/null ] && { echo "masked|$x"; continue; }
    [ -f "$x" ] && once "$x" || continue
    awk -v p="$k|$x|" '!/^[[:space:]]*([#;]|$)/ {print p $0}' "$x" 2>/dev/null
    owner "$x"
  done
}
# kernel settings: the files sysctl --system reads; systemd-sysctl reads sysctl.conf
# only through a link in sysctl.d (99-sysctl.conf), at the place of its name
for x in /etc/sysctl.d/*.conf; do
  [ -L "$x" ] && [ "$(readlink -f "$x")" = /etc/sysctl.conf ] && echo "sysctl_link|$x"
done
once /etc/sysctl.conf
f sysctl /etc/sysctl.d/*.conf /run/sysctl.d/*.conf /usr/local/lib/sysctl.d/*.conf /usr/lib/sysctl.d/*.conf \
  /lib/sysctl.d/*.conf
seen=; f sysctl /etc/sysctl.conf
more=$(cat /etc/sysctl.d/*.conf /run/sysctl.d/*.conf /etc/sysctl.conf 2>/dev/null \
       | sed -n 's/^[[:space:]]*-\{0,1\}\([A-Za-z0-9_./-]*\)[[:space:]]*=.*/\1/p')
for k in $(printf '%s\n' {{ import_cluster_os_defaults.cassandra_linux_sysctl.keys() | map('quote') | join(' ') }} $more | sort -u); do
  echo "sysctl_live|$k|$(sysctl -n "$k" 2>/dev/null | tr -s '[:space:]' ' ' | sed 's/ $//')"
done
# limits of the cassandra user, of the unit, of the running Cassandra
seen=; f limits /etc/security/limits.conf /etc/security/limits.d/*.conf
# the block earlier versions of cassandra_linux wrote in limits.conf (it removes it)
awk '/^#<!-- BEGIN ANSIBLE MANAGED BLOCK -->/ {b = 1; print "limits_block_found|"; next}
     /^#<!-- END ANSIBLE MANAGED BLOCK -->/ {b = 0}
     b && !/^[[:space:]]*([#;]|$)/ {print "limits_block|" $0}' /etc/security/limits.conf 2>/dev/null
echo "groups|$(id -Gn cassandra 2>/dev/null)"
systemctl cat cassandra 2>/dev/null | awk '/^# \// {p=$2}
  /^[[:space:]]*Limit(NOFILE|NPROC|MEMLOCK|AS)=/ {sub(/^[[:space:]]*/, ""); print "unit|" p "|" $0}'
for p in $(pgrep -x java); do
  tr '\0' '\n' < /proc/$p/cmdline | grep -qx org.apache.cassandra.service.CassandraDaemon || continue
  sed -n 's/^\(Max \(open files\|processes\|locked memory\|address space\)\)  *\([^ ]*\)  *\([^ ]*\).*/proc_limit|\1|\3|\4/p' /proc/$p/limits
  break
done
# transparent huge pages, and what disables them
t=/sys/kernel/mm/transparent_hugepage
[ -f $t/enabled ] && echo "thp|enabled|$(cat $t/enabled)" && echo "thp|defrag|$(cat $t/defrag 2>/dev/null)"
echo "cmdline|$(cat /proc/cmdline 2>/dev/null)"
for x in /etc/default/grub /etc/default/grub.d/*.cfg; do
  grep -s transparent_hugepage "$x" | grep -v '^[[:space:]]*#' | awk -v p="grub|$x|" '{print p $0}'
done
seen=
for x in /etc/systemd/system/*.service /usr/lib/systemd/system/*.service /lib/systemd/system/*.service \
         /etc/rc.d/rc.local /etc/rc.local; do
  [ -f "$x" ] && grep -qs transparent_hugepage "$x" && once "$x" || continue
  case $x in
    *.service) s=$(systemctl is-enabled "${x##*/}" 2>/dev/null) ;;
    *) if [ -x "$x" ]; then s=executable; else s="not executable"; fi ;;
  esac
  echo "thp_unit|$x|$s"
done
# the unit of cassandra_linux: its content (as the copy module compares it) and its state at boot
u=/etc/systemd/system/disable-thp.service
[ -f "$u" ] && echo "thp_own|sum|$(sha1sum < "$u" | cut -d' ' -f1)"
echo "thp_own|boot|$(systemctl is-enabled disable-thp 2>/dev/null)"
# tuned: the active profile(s), and the profiles they include
if [ -f /etc/tuned/active_profile ]; then
  todo=$(cat /etc/tuned/active_profile)
  echo "tuned|$todo|$(systemctl is-active tuned 2>/dev/null)"
  seen= n=0
  while [ -n "$todo" ] && [ $n -lt 10 ]; do
    n=$((n + 1)); p=${todo%% *}; todo=$(echo ${todo#"$p"})
    for d in /etc/tuned/profiles/$p /etc/tuned/$p /usr/lib/tuned/profiles/$p /usr/lib/tuned/$p; do
      [ -f "$d/tuned.conf" ] || continue
      f tuned_conf "$d/tuned.conf"
      todo="$todo $(sed -n 's/^[[:space:]]*include[[:space:]]*=[[:space:]]*//p' "$d/tuned.conf" | tr ',' ' ')"
      todo=$(echo $todo)
      break
    done
  done
fi
# the devices of the data and commitlog dirs, from their filesystems down to the
# disks: read-ahead, scheduler, SSD or not, and the read-ahead of the LVM volumes
l=$(lsblk -J -o NAME,KNAME,MAJ:MIN,TYPE,MOUNTPOINT,FSTYPE,RA,ROTA,SCHED 2>/dev/null | tr -d '\n')
echo "lsblk|$l"
case $l in *'"lvm"'*)
  lvs -a --noheadings --separator '|' --units s --nosuffix \
    -o lv_kernel_major,lv_kernel_minor,vg_name,lv_name,lv_read_ahead 2>/dev/null | sed 's/^/lvs|/' ;;
esac
# (a directory not there yet: the filesystem of its nearest parent, as cassandra_linux does)
mnt() {
  e=$2 m=; [ -e "$e" ] || m="#missing "
  while [ ! -e "$e" ] && [ "$e" != / ]; do e=$(dirname "$e"); done
  echo "mnt|$1|$2|$m$(findmnt -J -o MAJ:MIN,SOURCE,FSTYPE,TARGET --target "$e" 2>/dev/null | tr -d '\n')"
}
for d in "$@"; do
  if [ "$d" = {{ _commitlog_only | quote }} ]; then mnt commitlog "$d"; else mnt data "$d"; fi
done
for d in {{ _others | map('quote') | join(' ') }}; do mnt other "$d"; done
seen=
for x in /etc/udev/rules.d/*.rules /run/udev/rules.d/*.rules /usr/lib/udev/rules.d/*.rules /lib/udev/rules.d/*.rules; do
  [ -L "$x" ] && [ "$(readlink -f "$x")" = /dev/null ] && { echo "masked|$x"; continue; }
  [ -f "$x" ] && once "$x" || continue
  grep -E 'read_ahead_kb|queue/scheduler|--setra' "$x" | grep -v '^[[:space:]]*#' | awk -v p="udev|$x|" '{print p $0}' \
    | grep . && owner "$x"
done
# swap
awk '!/^[[:space:]]*#/ && $3 == "swap" {print "swap_fstab|" $0}' /etc/fstab 2>/dev/null
awk 'NR > 1 {print "swap_on|" $1 " " $2 " " $3 "K"}' /proc/swaps 2>/dev/null
# time sync
ids=
for s in chronyd chrony ntpd ntp ntpsec openntpd systemd-timesyncd; do
  [ "$(systemctl is-active $s 2>/dev/null)" = active ] || continue
  id=$(systemctl show -p Id --value $s 2>/dev/null); id=${id%.service}; id=${id:-$s}  # no --value before systemd 230
  case " $ids " in *" $id "*) continue ;; esac; ids="$ids $id"
  echo "timesync|$id|active|$(systemctl is-enabled $s 2>/dev/null)"
done
# the services cassandra_linux picks from (chronyd; on Debian chrony where installed, else systemd-timesyncd)
[ -x /usr/sbin/chronyd ] && echo "chrony_installed|"
for s in chronyd chrony systemd-timesyncd; do
  echo "timesync_own|$s|$(systemctl is-active $s 2>/dev/null)|$(systemctl is-enabled $s 2>/dev/null)"
done
for x in /etc/chrony.conf /etc/chrony/chrony.conf /etc/chrony.d/*.conf /etc/chrony/conf.d/*.conf \
         /etc/chrony/sources.d/*.sources /etc/ntp.conf /etc/ntpsec/ntp.conf /etc/systemd/timesyncd.conf \
         /etc/systemd/timesyncd.conf.d/*.conf; do
  [ -f "$x" ] && grep -E '^[[:space:]]*(server|pool|peer|NTP=|FallbackNTP=)' "$x" | awk -v p="timesync_server|$x|" '{print p $0}'
done
# firewall: firewalld, ufw, else iptables/nftables rules for the Cassandra ports; running or not, at boot or not
# (is-enabled exits 1 for disabled: its output says it; none, or not-found: not installed)
# (their English output is read below)
LC_ALL=C; export LC_ALL
for s in firewalld ufw; do
  b=$(systemctl is-enabled $s 2>/dev/null)
  case $b in ''|not-found) ;; *) echo "fw_state|$s|$(systemctl is-active $s 2>/dev/null)|$b" ;; esac
done
if command -v ufw >/dev/null; then
  echo "fw_state|ufw-rules|$(ufw status 2>/dev/null | sed -n 's/^Status: //p')|$(sed -n 's/^ENABLED=//p' /etc/ufw/ufw.conf 2>/dev/null)"
fi
# a list firewall-cmd or ufw cannot give (D-Bus down, starting) is said (fw_unread), never read as no rule
if [ "$(systemctl is-active firewalld 2>/dev/null)" = active ] && command -v firewall-cmd >/dev/null; then
  d=$(firewall-cmd --get-default-zone 2>/dev/null) || echo "fw_unread|firewalld|the default zone"
  echo "fw|firewalld|active|default zone $d"
  a=$(firewall-cmd --get-active-zones 2>/dev/null) || echo "fw_unread|firewalld|the active zones"
  # every rule of the default zone and of the active ones, now and after a reload (permanent)
  for z in $( { echo "$d"; echo "$a" | grep -v '^[[:space:]]' | awk '{print $1}'; } | grep . | sort -u); do
    for c in "" "--permanent"; do
      w=${c:+permanent }
      if l=$(firewall-cmd $c --zone="$z" --list-ports 2>/dev/null); then
        [ -n "$l" ] && echo "fw_rule|zone $z|${w}ports $l"
      else echo "fw_unread|zone $z|${w}ports"; fi
      # the zone itself: its target (ACCEPT lets every port in; one line of --info-zone), whole protocols,
      # source ports, forward ports (one per line)
      if l=$(firewall-cmd $c --info-zone="$z" 2>/dev/null); then
        v=$(echo "$l" | sed -n 's/^[[:space:]]*target: *//p')
        [ -n "$v" ] && echo "fw_rule|zone $z|${w}target $v"
      else echo "fw_unread|zone $z|${w}target"; fi
      for f in protocols source-ports forward-ports; do
        if l=$(firewall-cmd $c --zone="$z" --list-$f 2>/dev/null); then
          case $f in
            forward-ports) echo "$l" | grep . | awk -v p="fw_rule|zone $z|${w}$f " '{print p $0}' ;;
            *) [ -n "$l" ] && echo "fw_rule|zone $z|${w}$f $l" ;;
          esac
        else echo "fw_unread|zone $z|${w}$f"; fi
      done
      if v=$(firewall-cmd $c --zone="$z" --list-services 2>/dev/null); then
        for s in $v; do
          if l=$(firewall-cmd $c --info-service="$s" 2>/dev/null); then
            p=$(echo "$l" | sed -n 's/^[[:space:]]*ports: *//p')
            [ -n "$p" ] && echo "fw_rule|zone $z|${w}service $s: $p"
            # (what else a service may open: whole protocols, source ports, other services)
            for f in protocols source-ports includes; do
              p=$(echo "$l" | sed -n "s/^[[:space:]]*$f: *//p")
              [ -n "$p" ] && echo "fw_rule|zone $z|${w}service $s $f: $p"
            done
          else echo "fw_unread|zone $z|${w}service $s"; fi
        done
      else echo "fw_unread|zone $z|${w}services"; fi
      if l=$(firewall-cmd $c --zone="$z" --list-rich-rules 2>/dev/null); then
        echo "$l" | grep . | awk -v p="fw_rule|zone $z|${w}rich rule " '{print p $0}'
        # the ports of the services they name (now, or after a reload: as each set defines them)
        for s in $(echo "$l" | sed -n 's/.* service name="\([^"]*\)".*/\1/p' | sort -u); do
          if p=$(firewall-cmd $c --info-service="$s" 2>/dev/null); then
            echo "fw_svc|${w}$s|$(echo "$p" | sed -n 's/^[[:space:]]*ports: *//p')"
          else echo "fw_unread|zone $z|${w}service $s (named by a rich rule)"; fi
        done
      else echo "fw_unread|zone $z|${w}rich rules"; fi
    done
  done
  # policies (firewalld 0.9+), now and after a reload: each one as --info-policy prints it (the import
  # stops on one to this host, egress HOST, but an empty CONTINUE one or the RHEL allow-host-ipv6 as shipped)
  for c in "" "--permanent"; do
    w=${c:+permanent }
    # (before firewalld 0.9 there are none: the option is unknown, nothing to say; any other failure: said)
    if ! q=$(firewall-cmd $c --get-policies 2>&1); then
      echo "$q" | grep -q 'unrecognized arguments' || echo "fw_unread|firewalld|${w}policies"
      continue
    fi
    for y in $q; do
      if i=$(firewall-cmd $c --info-policy="$y" 2>/dev/null); then
        echo "$i" | awk -v p="fw_policy|${w}$y|" '{print p $0}'
      else echo "fw_unread|policy $y|${w}policy"; fi
    done
  done
  # zones bound to sources (they let them in by their own rules: said, not compared)
  echo "$a" | awk '/^[^[:space:]]/ {z=$1} /^[[:space:]]+sources:/ {sub(/^[[:space:]]+sources: */, ""); print "fw_zone|zone " z "|sources " $0}'
  # direct rules (said when they name a Cassandra port, not compared; none said when they cannot be listed)
  for c in "" "--permanent"; do
    firewall-cmd $c --direct --get-all-rules 2>/dev/null | awk -v p="fw_direct|${c:+permanent }" '{print p $0}'
  done
elif command -v ufw >/dev/null && ! ufw status >/dev/null 2>&1; then
  echo "fw|ufw|status unknown|"
  echo "fw_unread|ufw|ufw status"
elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
  # (IPV6=no in /etc/default/ufw: its rules, the role ones too, are IPv4 only)
  echo "fw|ufw|active|$(grep -Eqs '^IPV6=("no"|no)[[:space:]]*$' /etc/default/ufw && echo IPV6=no)"
  # every rule (ALLOW, DENY, REJECT, LIMIT), under the header; what comes in by default
  ufw status 2>/dev/null | awk 'r && NF {print "fw_rule|ufw|" $0} /^--/ {r=1}'
  ufw status verbose 2>/dev/null | sed -n 's/^Default: \([a-z]*\) (incoming).*/fw_rule|ufw|default incoming \1/p'
  # the ports of its app profiles (a rule may name one): the lines under Port(s), their indent dropped
  ufw app list 2>/dev/null | sed -n 's/^  *//p' | while IFS= read -r a; do
    echo "fw_svc|ufw app $a|$(ufw app info "$a" 2>/dev/null | sed -n '/^Ports*:/,$p' | tail -n +2 | tr -d ' ' | tr '\n' ' ')"
  done
else
  # only when their tables are there already (listing them would load the kernel modules)
  if grep -qsx filter /proc/net/ip_tables_names || { [ -e /sys/module/nf_tables ] && iptables -V 2>/dev/null | grep -q nf_tables; }; then
    pol=$(iptables -S INPUT 2>/dev/null | sed -n 's/^-P INPUT //p')
    [ -n "$pol" ] && [ "$pol" != ACCEPT ] && echo "fw|iptables|INPUT policy $pol|"
    iptables -S 2>/dev/null | grep -E -- "--dports? ([0-9]+[,:])*($ports)([,:]|[[:space:]]|$)" | grep -- '-j ACCEPT' \
      | awk '{print "fw_rule|iptables|" $0}'
  fi
  if [ -e /sys/module/nf_tables ] && command -v nft >/dev/null; then
    nft list ruleset 2>/dev/null | grep -E "dport.*[^0-9]($ports)([^0-9]|$)" | grep accept | awk '{print "fw_rule|nftables|" $0}'
  fi
fi
exit 0

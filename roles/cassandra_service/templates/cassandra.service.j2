# {{ ansible_managed }}
# Native unit replacing the packages' SysV init script.
[Unit]
Description=Apache Cassandra
Documentation=https://cassandra.apache.org/doc/latest/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ cassandra_service_user }}
Group={{ cassandra_service_group }}
{% for name, value in cassandra_service_environment.items() %}
Environment="{{ name }}={{ value }}"
{% endfor %}
ExecStart=/usr/sbin/cassandra -f
# JVM exit status on SIGTERM
SuccessExitStatus=143
TimeoutStopSec={{ cassandra_service_timeout_stop }}
Restart={{ cassandra_service_restart }}
RestartSec=30
LimitNOFILE={{ cassandra_service_limit_nofile }}
LimitNPROC={{ cassandra_service_limit_nproc }}
LimitMEMLOCK={{ cassandra_service_limit_memlock }}
LimitAS={{ cassandra_service_limit_as }}

[Install]
WantedBy=multi-user.target

<!--
In order to disable debug.log, comment-out the ASYNCDEBUGLOG
appender reference in the root level section below.
-->

<configuration scan="true" scanPeriod="60 seconds">
  <!-- No shutdown hook; we run it ourselves in StorageService after shutdown -->

  <!-- SYSTEMLOG rolling file appender to system.log (INFO level) -->

  <appender name="SYSTEMLOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <file>${cassandra.logdir}/system.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!-- rollover daily -->
      <fileNamePattern>${cassandra.logdir}/system.log.%d{yyyy-MM-dd}.%i.zip</fileNamePattern>
      <!-- each file should be at most 50MB, keep 7 days worth of history, but at most 5GB -->
      <maxFileSize>{{ cassandra_log_system_max_file_size }}</maxFileSize>
      <maxHistory>{{ cassandra_log_system_max_history }}</maxHistory>
      <totalSizeCap>{{ cassandra_log_system_total_size_cap }}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>{{ cassandra_log_pattern }}</pattern>
    </encoder>
  </appender>

  <!-- DEBUGLOG rolling file appender to debug.log (all levels) -->

  <appender name="DEBUGLOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${cassandra.logdir}/debug.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!-- rollover daily -->
      <fileNamePattern>${cassandra.logdir}/debug.log.%d{yyyy-MM-dd}.%i.zip</fileNamePattern>
      <!-- each file should be at most 50MB, keep 7 days worth of history, but at most 5GB -->
      <maxFileSize>{{ cassandra_log_debug_max_file_size }}</maxFileSize>
      <maxHistory>{{ cassandra_log_debug_max_history }}</maxHistory>
      <totalSizeCap>{{ cassandra_log_debug_total_size_cap }}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>{{ cassandra_log_pattern }}</pattern>
    </encoder>
  </appender>

  <!-- ASYNCLOG assynchronous appender to debug.log (all levels) -->

  <appender name="ASYNCDEBUGLOG" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>1024</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <includeCallerData>true</includeCallerData>
    <appender-ref ref="DEBUGLOG" />
  </appender>

  <!-- STDOUT console appender to stdout (INFO level) -->

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>{{ cassandra_log_pattern }}</pattern>
    </encoder>
  </appender>

  <!-- Uncomment below configuration (Audit Logging (FileAuditLogger) rolling file appender and Audit Logging
  additivity) in order to have the log events flow through separate log file instead of system.log.
  Audit Logging (FileAuditLogger) rolling file appender to audit.log -->
  {{ '' if cassandra_log_audit_file else '<!-- ' }}<appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>{{ cassandra_log_audit_dir }}/audit.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">{{ '' if cassandra_log_audit_file else ' -->' }}
      <!-- rollover daily -->
      {{ '' if cassandra_log_audit_file else '<!-- ' }}<fileNamePattern>{{ cassandra_log_audit_dir }}/audit.log.%d{yyyy-MM-dd}.%i.zip</fileNamePattern>{{ '' if cassandra_log_audit_file else ' -->' }}
      <!-- each file should be at most 50MB, keep 30 days worth of history, but at most 5GB -->
      {{ '' if cassandra_log_audit_file else '<!-- ' }}<maxFileSize>{{ cassandra_log_audit_max_file_size }}</maxFileSize>
      <maxHistory>{{ cassandra_log_audit_max_history }}</maxHistory>
      <totalSizeCap>{{ cassandra_log_audit_total_size_cap }}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>{{ cassandra_log_pattern }}</pattern>
    </encoder>
  </appender>{{ '' if cassandra_log_audit_file else ' -->' }}

  <!-- Audit Logging additivity to redirect audit logging events to audit/audit.log -->
  {{ '' if cassandra_log_audit_file else '<!-- ' }}<logger name="org.apache.cassandra.audit" additivity="false" level="INFO">
    <appender-ref ref="AUDIT"/>
  </logger>{{ '' if cassandra_log_audit_file else ' -->' }}

  <!-- Uncomment bellow and corresponding appender-ref to activate logback metrics
  <appender name="LogbackMetrics" class="com.codahale.metrics.logback.InstrumentedAppender" />
   -->

  <!-- Uncomment below configuration and corresponding appender-ref to activate
  logging into system_views.system_logs virtual table. -->
  {{ '' if cassandra_log_cql_table else '<!-- ' }}<appender name="CQLLOG" class="org.apache.cassandra.utils.logging.VirtualTableAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>{{ cassandra_log_cql_table_level }}</level>
    </filter>
  </appender>{{ '' if cassandra_log_cql_table else ' -->' }}

{{ (_cassandra_config_snippet_appenders ~ '\n') if _cassandra_config_snippet_appenders else '' }}  <root level="{{ cassandra_log_level }}">
    <appender-ref ref="SYSTEMLOG" />
    {{ '' if cassandra_log_console else '<!-- ' }}<appender-ref ref="STDOUT" />{{ '' if cassandra_log_console else ' -->' }}
    {{ '' if cassandra_debug_log_enabled else '<!-- ' }}<appender-ref ref="ASYNCDEBUGLOG" />{{ '' if cassandra_debug_log_enabled else ' -->' }} <!-- Comment this line to disable debug.log -->{{ ('\n' ~ (_cassandra_config_logback_refs | join('\n'))) if _cassandra_config_logback_refs else '' }}
    <!--
    <appender-ref ref="LogbackMetrics" />
    -->
    <!--
    <appender-ref ref="CQLLOG"/>
    -->
  </root>

  <logger name="org.apache.cassandra" level="{{ cassandra_log_level_cassandra }}"/>{{ ('\n' ~ (_cassandra_config_log_levels | join('\n'))) if _cassandra_config_log_levels else '' }}{{ ('\n' ~ _cassandra_config_snippet_logback) if _cassandra_config_snippet_logback else '' }}
</configuration>
